# Copy to a private env file. Tokens never belong in git.
# Persistent state directory; create it yourself with mode 0700.
AGENT_BUS_STATE_DIR=REPLACE_WITH_PERSISTENT_STATE_DIRECTORY
# Generate a unique high-entropy bearer token; this placeholder is not a secret.
AGENT_BUS_BEARER_SECRET=REPLACE_WITH_OPERATOR_GENERATED_TOKEN
# Only "loopback" is accepted by the bridge.
AGENT_BUS_BIND_HOST=loopback
# Decimal listener port.
AGENT_BUS_PORT=REPLACE_WITH_LISTENER_PORT
# Each identity is fixed at startup: 1--64 characters, [A-Za-z0-9_-] only.
AGENT_BUS_PRODUCER_ID=REPLACE_WITH_PRODUCER_ID
AGENT_BUS_WORKER_ID=REPLACE_WITH_WORKER_ID
